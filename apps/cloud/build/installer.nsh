!macro customWelcomePage
  !define MUI_WELCOMEPAGE_TITLE "Welcome to Afterglide Cloud"
  !define MUI_WELCOMEPAGE_TEXT "A focused Xbox Cloud Gaming client for Windows.$\r$\n$\r$\nThis preview installs for your Windows account. After setup, sign in through Microsoft's device-code page.$\r$\n$\r$\nXbox determines available games, regions and subscription requirements. A connected controller is recommended.$\r$\n$\r$\nClick Next to continue."
  !insertmacro MUI_PAGE_WELCOME
!macroend
